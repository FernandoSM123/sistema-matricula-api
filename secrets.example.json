// Plantilla de los SECRETOS de la API. Cópiala a tu secrets.json de user-secrets
// (ver README, "Configurar user-secrets") y reemplaza los valores de ejemplo.
// Nunca pongas estos valores en appsettings*.json ni subas tu copia al repositorio.
// La configuración que no es secreta está en src/Matricula.Api/appsettings*.json.
// En otros entornos, cada clave es una variable de entorno con "__" en lugar de ":",
// por ejemplo Jwt__Clave. La tabla completa está en el README ("Todas las claves").
{
  "ConnectionStrings": {
    // Opcional si tu PostgreSQL usa postgres/postgres (el valor de appsettings.Development.json).
    // Si la contraseña tiene ; " o ', enciérrala en comillas dobles escapadas, como aquí.
    "Matricula": "Host=localhost;Port=5432;Database=matricula;Username=postgres;Password=\"TU_CONTRASEÑA\""
  },
  "Jwt": {
    // Obligatoria: al menos 32 caracteres, o la API no arranca. Cambiarla invalida los tokens emitidos.
    "Clave": "REEMPLAZAR-con-una-clave-aleatoria-de-32-o-mas-caracteres"
  },
  "AdminSeed": {
    // Obligatoria mientras no exista un administrador. Política: 8 caracteres, una mayúscula y un número.
    "ContrasenaTemporal": "TuTemporal123"
  },
  "Smtp": {
    // Solo si el servidor SMTP pide autenticación (smtp4dev no la pide).
    "Usuario": "",
    "Contrasena": ""
  },
  "DatosPrueba": {
    // Solo desarrollo. Con Habilitado = true, siembra datos de prueba en una BD vacía.
    "Habilitado": false,
    // Contraseña de todas las cuentas de prueba y del administrador inicial. Misma política.
    "Contrasena": "TuPrueba123"
  }
}
