@host = http://localhost:5022

# Recorrido de los módulos acceso, estudiantes, profesores, catalogos, grupos y matriculas. Ejecuta primero el login con tus credenciales: las demás peticiones usan
# {{token}}. Primer ingreso: login con la temporal de AdminSeed → cambio-obligatorio → login con la nueva.

GET {{host}}/health

###

# Login (RF-06). Con la temporal del administrador inicial responde debeCambiarContrasena: true.
# @name login
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "correo": "admin@instituto.local",
  "contrasena": "TuTemporal123"
}

###

@token = {{login.response.body.$.accessToken}}

# Credenciales inválidas → 401 con mensaje genérico.
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "correo": "admin@instituto.local",
  "contrasena": "Incorrecta123"
}

###

# Validación → 400 con traceId.
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{}

###

# Perfil propio (RF-13). Con el token de una temporal responde 403 RN-24.
GET {{host}}/api/v1/me
Authorization: Bearer {{token}}

###

# Sin token → 401.
GET {{host}}/api/v1/me

###

# Cambio obligatorio (RF-07) con el token de la temporal. Devuelve un token nuevo; el anterior deja de valer.
# Confirmación distinta → 400; nueva igual a la temporal → 409 RN-25; sin cambio pendiente → 403.
POST {{host}}/api/v1/auth/cambio-obligatorio
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nuevaContrasena": "NuevaClave2026",
  "confirmacion": "NuevaClave2026"
}

###

# Cambiar la contraseña propia (RF-09). Actual incorrecta → 409 RF-09; nueva igual a la actual → 409 RN-25.
POST {{host}}/api/v1/auth/cambiar-contrasena
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contrasenaActual": "NuevaClave2026",
  "nuevaContrasena": "OtraClave2026",
  "confirmacion": "OtraClave2026"
}

###

# Logout (RF-08): 204 y todos los tokens del usuario dejan de valer.
POST {{host}}/api/v1/auth/logout
Authorization: Bearer {{token}}

###

# Olvido de contraseña (RF-10). Siempre 200 con el mismo mensaje; la temporal (1 hora) llega a smtp4dev.
# Límite: 5 solicitudes cada 15 minutos por IP (después 429).
POST {{host}}/api/v1/auth/olvido-contrasena
Content-Type: application/json

{
  "correo": "admin@instituto.local"
}

###

# Registrar un administrador (RF-04). Requiere el token de un administrador sin cambio pendiente.
# 201 + Location; la temporal llega a smtp4dev y nunca a la respuesta. Correo o cédula repetidos → 409 RN-13.
POST {{host}}/api/v1/administradores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cedula": "1-2345-6789",
  "nombre": "Ana",
  "apellidos": "Mora Solís",
  "telefono": "8888-8888",
  "correo": "ana@instituto.local"
}

###

GET {{host}}/api/v1/administradores/1
Authorization: Bearer {{token}}

###

# Listar administradores (RF-55): paginado, solo activos salvo incluirInactivos=true.
GET {{host}}/api/v1/administradores?page=1&pageSize=20&search=&incluirInactivos=false
Authorization: Bearer {{token}}

###

# Editar un administrador, incluido el propio (RF-55). Cambiar el correo cambia el de su cuenta.
PUT {{host}}/api/v1/administradores/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cedula": "000000000",
  "nombre": "John",
  "apellidos": "Doe",
  "telefono": "00000000",
  "correo": "admin@instituto.local"
}

###

# Reenviar una temporal (RF-12). El id es el usuarioId. Cuenta inactiva → 409 RN-29.
POST {{host}}/api/v1/usuarios/2/reenviar-temporal
Authorization: Bearer {{token}}

###

# Desactivar una cuenta (RF-14): sus tokens dejan de valer. Último administrador activo → 409 RN-30.
POST {{host}}/api/v1/usuarios/2/desactivar
Authorization: Bearer {{token}}

###

POST {{host}}/api/v1/usuarios/2/reactivar
Authorization: Bearer {{token}}

###


# --- Módulo estudiantes ---

# Registrar un estudiante por un administrador (RF-02). 201 + Location; la temporal llega a smtp4dev.
# Correo o cédula de un activo repetidos → 409 RN-13; cédula de un inactivo → 409 RN-39 con estudianteId y usuarioId.
POST {{host}}/api/v1/estudiantes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cedula": "1-1111-1111",
  "nombre": "Laura",
  "apellidos": "Jiménez Vega",
  "telefono": "8888-1111",
  "correo": "laura.jimenez@correo.local",
  "fechaNacimiento": "2002-03-15",
  "direccion": "Cartago"
}

###

# Detalle de un estudiante (RF-17). Inexistente → 404; con token de estudiante → 403.
GET {{host}}/api/v1/estudiantes/1
Authorization: Bearer {{token}}

###


# Listar estudiantes (RF-16): paginado, solo activos salvo incluirInactivos=true; search en nombre, apellidos, cédula y correo.
GET {{host}}/api/v1/estudiantes?page=1&pageSize=20&search=&incluirInactivos=false
Authorization: Bearer {{token}}

###

# Editar un estudiante (RF-18). Cambiar el correo cambia el de su cuenta (RN-31); la fecha de registro no cambia.
# Cédula de otro estudiante o correo de otra cuenta → 409 RN-13.
PUT {{host}}/api/v1/estudiantes/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cedula": "1-1111-1111",
  "nombre": "Laura María",
  "apellidos": "Jiménez Vega",
  "telefono": "8888-1212",
  "correo": "laura.nueva@correo.local",
  "fechaNacimiento": "2002-03-16",
  "direccion": null
}

###


# Desactivar un estudiante (RF-19, RN-38): desactiva su cuenta y cierra sus sesiones. Es lo mismo que
# /usuarios/{usuarioId}/desactivar. La guarda RN-36 la añade el módulo matriculas.
POST {{host}}/api/v1/estudiantes/1/desactivar
Authorization: Bearer {{token}}

###

# Reactivar un estudiante (RF-19, RN-39): un estudiante que regresa se reactiva, no se registra de nuevo.
POST {{host}}/api/v1/estudiantes/1/reactivar
Authorization: Bearer {{token}}

###


# Registro público de estudiantes (RF-01), sin token. Siempre crea una cuenta de estudiante (RN-19): un campo rol se ignora.
# 201 con un mensaje, sin Location; después se inicia sesión con /auth/login. Cédula o correo existentes → 409 RN-21.
# Rate limiting: 10 cada 15 minutos por IP (429).
POST {{host}}/api/v1/estudiantes/registro
Content-Type: application/json

{
  "cedula": "4-4444-4444",
  "nombre": "Carlos",
  "apellidos": "Quesada Ruiz",
  "telefono": "8888-4444",
  "correo": "carlos.q@correo.local",
  "fechaNacimiento": null,
  "direccion": null,
  "contrasena": "Registro2026",
  "confirmacion": "Registro2026"
}

###


# Datos de contacto propios: el estudiante edita su teléfono y su dirección y recibe su perfil actualizado.
# Requiere el token de un estudiante; otro rol → 403. Correo, cédula o nombre en el cuerpo se ignoran.
PUT {{host}}/api/v1/me/datos-contacto
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "telefono": "7777-0001",
  "direccion": "San Pedro, Montes de Oca"
}

###


# --- Módulo profesores ---

# Registrar un profesor (RF-03, RF-22). 201 + Location; la temporal llega a smtp4dev y nunca a la respuesta.
# Correo o cédula de un activo repetidos → 409 RN-13; cédula de un inactivo → 409 RN-39 con profesorId y usuarioId.
# La cédula es única por tabla (RN-13): puede coincidir con la de un estudiante o un administrador.
POST {{host}}/api/v1/profesores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cedula": "5-5555-5555",
  "nombre": "Elena",
  "apellidos": "Vargas Solano",
  "telefono": "8888-5555",
  "correo": "elena.vargas@correo.local",
  "especialidad": "Redes",
  "fechaContratacion": "2026-02-01"
}

###

# Detalle de un profesor (RF-24). Inexistente → 404; con token de profesor o estudiante → 403.
GET {{host}}/api/v1/profesores/1
Authorization: Bearer {{token}}

###

# Listar profesores (RF-23): paginado, solo activos salvo incluirInactivos=true; search en nombre, apellidos, cédula,
# especialidad y correo.
GET {{host}}/api/v1/profesores?page=1&pageSize=20&search=redes&incluirInactivos=false
Authorization: Bearer {{token}}

###

# Editar un profesor (RF-25). Cambiar el correo cambia el de su cuenta (RN-31). Especialidad vacía → se quita.
# Cédula de otro profesor o correo de otra cuenta → 409 RN-13.
PUT {{host}}/api/v1/profesores/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cedula": "5-5555-5555",
  "nombre": "Elena",
  "apellidos": "Vargas Solano",
  "telefono": "8888-5556",
  "correo": "elena.vargas@correo.local",
  "especialidad": "Programación",
  "fechaContratacion": "2026-02-01"
}

###

# Desactivar un profesor (RF-26, RN-38): desactiva su cuenta y cierra sus sesiones. Es lo mismo que
# /usuarios/{usuarioId}/desactivar. Con grupos Planificado, Abierto, Cerrado o EnCurso → 409 RN-37 (por las dos rutas).
POST {{host}}/api/v1/profesores/1/desactivar
Authorization: Bearer {{token}}

###

# Reactivar un profesor (RF-26, RN-39): un profesor que regresa se reactiva, no se registra de nuevo.
POST {{host}}/api/v1/profesores/1/reactivar
Authorization: Bearer {{token}}

###

# Eliminar un profesor (RF-26): 204 si nunca tuvo grupos; se elimina también su cuenta (RN-35) y sus tokens dejan de
# valer. Su correo y su cédula se pueden registrar de nuevo. Con algún grupo, incluso cancelado → 409 RN-34 (desactivarlo).
DELETE {{host}}/api/v1/profesores/1
Authorization: Bearer {{token}}

###


# --- Módulo catalogos ---

# Registrar un curso (RF-29). 201 + Location. El código se guarda en mayúsculas.
# Código de un curso activo → 409 RN-13; de uno inactivo → 409 RN-39 con cursoId. Otro rol → 403.
POST {{host}}/api/v1/cursos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo": "prog-101",
  "nombre": "Programación I",
  "descripcion": "Fundamentos de programación",
  "duracionHoras": 40,
  "costo": 150000.00,
  "nivel": "Basico"
}

###

# Detalle de un curso (RF-31), con cualquier sesión. Inexistente → 404.
GET {{host}}/api/v1/cursos/1
Authorization: Bearer {{token}}

###

# Listar cursos (RF-30), con cualquier sesión: paginado por nombre, solo activos salvo incluirInactivos=true (RN-41).
# search busca en nombre y código; nivel es Basico, Intermedio o Avanzado (otro valor → 400).
GET {{host}}/api/v1/cursos?page=1&pageSize=20&search=prog&nivel=Basico&incluirInactivos=false
Authorization: Bearer {{token}}

###

# Editar un curso (RF-32), también si está inactivo. Código de otro curso, activo o inactivo → 409 RN-13.
PUT {{host}}/api/v1/cursos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo": "PROG-101",
  "nombre": "Programación I",
  "descripcion": null,
  "duracionHoras": 48,
  "costo": 175000.00,
  "nivel": "Intermedio"
}

###

# Desactivar un curso (RF-33): 204, también al repetir. Con grupos activos → 409 RN-37.
POST {{host}}/api/v1/cursos/1/desactivar
Authorization: Bearer {{token}}

###

# Reactivar un curso (RF-33, RN-39): 204, también al repetir.
POST {{host}}/api/v1/cursos/1/reactivar
Authorization: Bearer {{token}}

###

# Registrar un aula (RF-39). 201 + Location. El código se guarda en mayúsculas.
# Código de un aula activa → 409 RN-13; de una inactiva → 409 RN-39 con aulaId. Otro rol → 403.
POST {{host}}/api/v1/aulas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo": "lab-1",
  "ubicacion": "Edificio A, segundo piso",
  "capacidad": 25
}

###

# Detalle de un aula (RF-40), para administrador o profesor. Con token de estudiante → 403.
GET {{host}}/api/v1/aulas/1
Authorization: Bearer {{token}}

###

# Listar aulas (RF-40), para administrador o profesor: paginado por código, solo activas salvo incluirInactivos=true.
# search busca en código y ubicación.
GET {{host}}/api/v1/aulas?page=1&pageSize=20&search=edificio&incluirInactivos=false
Authorization: Bearer {{token}}

###

# Editar un aula (RF-40), también si está inactiva. Código de otra aula, activa o inactiva → 409 RN-13.
# Capacidad menor que el cupo de un grupo no Finalizado ni Cancelado → 409 RN-09.
PUT {{host}}/api/v1/aulas/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo": "LAB-1",
  "ubicacion": null,
  "capacidad": 30
}

###

# Desactivar un aula (RF-40): 204, también al repetir. Con grupos activos → 409 RN-37.
POST {{host}}/api/v1/aulas/1/desactivar
Authorization: Bearer {{token}}

###

# Reactivar un aula (RF-40, RN-39): 204, también al repetir.
POST {{host}}/api/v1/aulas/1/reactivar
Authorization: Bearer {{token}}

###

# Registrar un periodo (RF-35). 201 + Location. El nombre se guarda en mayúsculas; repetido → 409 RN-13.
# RN-16 → 400 en el campo: inicioMatricula < finMatricula, inicioClases < finClases, finMatricula ≤ finClases e
# inicioMatricula ≤ fechaLimiteRetiro ≤ finClases. Los periodos pueden traslaparse.
POST {{host}}/api/v1/periodos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "2027-i",
  "inicioClases": "2027-02-01",
  "finClases": "2027-06-30",
  "inicioMatricula": "2027-01-10",
  "finMatricula": "2027-02-10",
  "fechaLimiteRetiro": "2027-03-15"
}

###

# Listar periodos (RF-36), con cualquier sesión: paginado, los más recientes primero; search busca en el nombre.
GET {{host}}/api/v1/periodos?page=1&pageSize=20&search=2027
Authorization: Bearer {{token}}

###

# Periodo vigente (RF-38), con cualquier sesión: inicioMatricula ≤ hoy ≤ finClases, con la fecha de Instituto:ZonaHoraria.
# Si hay varios, el de inicioMatricula más reciente y luego el id mayor. Sin vigente → 404.
GET {{host}}/api/v1/periodos/vigente
Authorization: Bearer {{token}}

###

# Detalle de un periodo (RF-36), con cualquier sesión. Inexistente → 404.
GET {{host}}/api/v1/periodos/1
Authorization: Bearer {{token}}

###

# Editar un periodo (RF-36), también si ya pasó. Nombre de otro periodo → 409 RN-13; RN-16 → 400.
PUT {{host}}/api/v1/periodos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "2027-I",
  "inicioClases": "2027-02-08",
  "finClases": "2027-06-30",
  "inicioMatricula": "2027-01-10",
  "finMatricula": "2027-02-15",
  "fechaLimiteRetiro": "2027-01-31"
}

###

# Crear un grupo (RF-42): nace Planificado y sin horarios. 201 + Location. El NRC se guarda en mayúsculas.
# Presencial e Hibrida llevan aulaId; Virtual no (400). Curso, profesor o aula inactivos → 409 RN-17;
# cupo mayor que la capacidad del aula → 409 RN-09; NRC repetido → 409 RN-13; ids inexistentes → 404.
POST {{host}}/api/v1/grupos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nrc": "10001",
  "cursoId": 1,
  "profesorId": 1,
  "periodoId": 1,
  "aulaId": 1,
  "cupo": 25,
  "modalidad": "Presencial"
}

###

# Crear un grupo virtual: sin aulaId.
POST {{host}}/api/v1/grupos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nrc": "10002",
  "cursoId": 1,
  "profesorId": 1,
  "periodoId": 1,
  "aulaId": null,
  "cupo": 40,
  "modalidad": "Virtual"
}

###

# Listar grupos (RF-43), con cualquier sesión. Filtros: cursoId, profesorId, periodoId, estado, modalidad; search busca
# en el NRC. Orden: periodo más reciente, curso, NRC. Un profesor solo ve los suyos y un estudiante solo los Abierto,
# aunque envíen otro filtro (RN-18).
GET {{host}}/api/v1/grupos?periodoId=1&estado=Abierto&page=1&pageSize=20
Authorization: Bearer {{token}}

###

# Detalle de un grupo (RF-44): horarios, cupo, ocupados y disponibles. Inexistente → 404.
# Profesor con un grupo ajeno, o estudiante con un grupo que no está Abierto y en el que nunca se matriculó → 403 RN-18.
GET {{host}}/api/v1/grupos/1
Authorization: Bearer {{token}}

###

# Editar un grupo (RF-45): 200 con el detalle. En Planificado se cambia todo; en Abierto, Cerrado o EnCurso solo
# profesor, aula, modalidad y cupo (otro cambio → 409 RF-45); en Finalizado o Cancelado nada (409 RF-45).
# Curso, profesor o aula nuevos e inactivos → 409 RN-17; cupo sobre la capacidad → 409 RN-09; NRC de otro grupo
# → 409 RN-13; profesor o aula nuevos que chocan con otro grupo del periodo → 409 RN-07 / RN-08.
PUT {{host}}/api/v1/grupos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nrc": "10001",
  "cursoId": 1,
  "profesorId": 1,
  "periodoId": 1,
  "aulaId": 1,
  "cupo": 30,
  "modalidad": "Presencial"
}

###

# Agregar un bloque de horario (RF-48). 201 con el grupo. Horas "HH:mm" o "HH:mm:ss"; horaFin ≤ horaInicio → 400 (RN-15).
# Traslape con otro bloque del grupo → 409 RN-14. Choque con otro grupo del mismo profesor / aula en el mismo periodo
# → 409 RN-07 / RN-08, con el NRC del otro grupo (los cancelados no cuentan). Bloques contiguos sí se permiten.
# Si dejaría a algún estudiante matriculado con choque de horario → 409 RN-06 con cuántos y un NRC (sin nombres).
# Grupo finalizado o cancelado → 409 RF-48.
POST {{host}}/api/v1/grupos/1/horarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dia": "Lunes",
  "horaInicio": "08:00",
  "horaFin": "10:00"
}

###

# Quitar un bloque (RF-48): 204. Solo con el grupo Planificado; si no → 409 RF-48. Bloque de otro grupo → 404.
DELETE {{host}}/api/v1/grupos/1/horarios/1
Authorization: Bearer {{token}}

###

# Cambiar el estado de un grupo (RF-47): 204. Planificado → Abierto → Cerrado → EnCurso → Finalizado, un paso a la vez,
# o Cancelado mientras no haya finalizado. Abrir sin horarios, saltar, retroceder o cancelar un finalizado → 409 RF-47.
# Repetir el estado actual → 204 sin cambios. Cancelar retira las matrículas activas (motivo CancelacionGrupo, fecha de
# hoy) y libera sus cupos en el mismo guardado (RN-12), aunque haya pasado la fecha límite de retiro.
POST {{host}}/api/v1/grupos/1/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Abierto"
}

###

# Eliminar un grupo (RF-46): 204, en cualquier estado, junto con sus bloques de horario; su NRC queda libre. Si tuvo
# matrículas, aunque estén retiradas → 409 RN-34 (se cancela en su lugar). Inexistente → 404. Solo administrador.
DELETE {{host}}/api/v1/grupos/1
Authorization: Bearer {{token}}

###

# Oferta académica (RF-50): pública, sin token. Grupos Abierto del periodo vigente con horarios y cupos disponibles
# (incluidos los llenos); del profesor solo el nombre. Filtros: cursoId, modalidad; search busca en el curso y el NRC.
# Sin periodo vigente → 200 con la lista vacía.
GET {{host}}/api/v1/oferta-academica?search=prog&page=1&pageSize=20

###

# Grupos de un curso (RF-34), con cualquier sesión. Filtros: periodoId, estado; search busca en el NRC. El administrador
# ve cualquier estado; profesores y estudiantes solo los Abierto. Curso inexistente → 404.
GET {{host}}/api/v1/cursos/1/grupos?periodoId=1
Authorization: Bearer {{token}}

###

# Grupos de un profesor (RF-27), solo administrador: todos los estados; filtro periodoId; search por NRC. 404 si no existe.
GET {{host}}/api/v1/profesores/1/grupos?periodoId=1
Authorization: Bearer {{token}}

###

# Horario semanal de un profesor (RF-28), solo administrador: bloques por día y hora, sin grupos cancelados.
# Sin periodoId usa el vigente; si no hay vigente → 404 pidiendo el periodoId.
GET {{host}}/api/v1/profesores/1/horario?periodoId=1
Authorization: Bearer {{token}}

###

# Mis grupos (RF-27), solo con token de profesor (otro rol → 403). Mismos filtros que arriba.
GET {{host}}/api/v1/me/grupos?periodoId=1
Authorization: Bearer {{token}}

###

# Mi horario: con token de profesor, sus grupos (RF-28); con token de estudiante, los grupos en que tiene una matrícula
# activa (RF-21). Administrador → 403. Sin periodoId usa el vigente; sin vigente → 404 pidiendo el periodoId.
GET {{host}}/api/v1/me/horario
Authorization: Bearer {{token}}

###

# Ocupación de un aula (RF-41), solo administrador: bloques de sus grupos no cancelados en el periodo, de todos los
# profesores. Sin periodoId usa el vigente; si no hay vigente → 404 pidiendo el periodoId.
GET {{host}}/api/v1/aulas/1/ocupacion?periodoId=1
Authorization: Bearer {{token}}

###

# Eliminar un curso, aula o periodo (RF-33, RF-40, RF-37), solo administrador: 204 si nunca tuvo grupos. Con algún
# grupo, incluso cancelado → 409 RN-34 (el curso o aula se desactiva; el periodo se corrige o se conserva).
DELETE {{host}}/api/v1/cursos/1
Authorization: Bearer {{token}}

###

DELETE {{host}}/api/v1/aulas/1
Authorization: Bearer {{token}}

###

DELETE {{host}}/api/v1/periodos/1
Authorization: Bearer {{token}}

###

# --- Módulo matriculas ---

# Matricular a un estudiante (RF-51), solo administrador: 201 + Location. Al administrador no se le aplican el estado
# Abierto ni las fechas de matrícula, pero sí RN-01 (inactivo), RN-03 (sin cupo), RN-05 (curso repetido en el periodo),
# RN-06 (choque de horario) y RN-11 en grupos Finalizado o Cancelado. Dos peticiones por el último cupo: una 201 y la
# otra 409 RN-03 o CONCURRENCIA.
POST {{host}}/api/v1/matriculas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estudianteId": 1,
  "grupoId": 1
}

###

# Matricularse (RF-51), con el token de un estudiante: su id sale del token. El grupo debe estar Abierto (RN-02, RN-11)
# y hoy dentro del rango de matrícula del periodo (RN-04). Location → /matriculas/{id}.
POST {{host}}/api/v1/me/matriculas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "grupoId": 1
}

###

# Detalle de una matrícula: administrador o el estudiante dueño; la de otro estudiante → 403 RN-18.
GET {{host}}/api/v1/matriculas/1
Authorization: Bearer {{token}}

###

# Retirar una matrícula (RF-52): administrador o el estudiante dueño (otro → 403 RN-18). Queda Retirada con la fecha de
# hoy y el cupo se libera. El estudiante necesita el grupo Abierto (RN-11) y estar dentro de la fecha límite de retiro
# (RN-10); al administrador no se le aplican, salvo en grupos Finalizado o Cancelado. Ya retirada → 409 RF-52.
POST {{host}}/api/v1/matriculas/1/retiro
Authorization: Bearer {{token}}

###

# Cambiar de grupo (RF-53): administrador o el estudiante dueño. El destino debe ser otro grupo del mismo curso y periodo
# (si no → 409 RF-53). La matrícula original queda Retirada con motivo CambioGrupo y se crea una nueva: 201 + Location a
# la nueva. Si el destino no cumple (RN-02, RN-03, RN-06, RN-11) o el origen ya no permite retiros (RN-10, RN-11), no
# cambia nada. El cambio se rige por la fecha límite de retiro, no por el rango de matrícula.
POST {{host}}/api/v1/matriculas/1/cambio-grupo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "grupoDestinoId": 2
}

###

# Matrículas de un estudiante (RF-20, RF-54), solo administrador. Sin estado: historial de matrículas y retiros, con
# fechas y motivo; con estado=Activa: los cursos y grupos en que está matriculado. Filtro por periodo; search busca en
# el nombre o código del curso y en el NRC. Incluye estudiantes y grupos inactivos (RN-40).
GET {{host}}/api/v1/estudiantes/1/matriculas?periodoId=&estado=&search=&page=1&pageSize=20
Authorization: Bearer {{token}}

###

# Lo mismo para el estudiante de la sesión.
GET {{host}}/api/v1/me/matriculas?estado=Activa
Authorization: Bearer {{token}}

###

# Horario semanal de un estudiante (RF-21), solo administrador: bloques de los grupos con matrícula activa, por día y
# hora, sin grupos cancelados. Sin periodoId usa el vigente; estudiante o periodo inexistente → 404.
GET {{host}}/api/v1/estudiantes/1/horario?periodoId=1
Authorization: Bearer {{token}}

###

# Estudiantes de un grupo (RF-49): administrador o el profesor del grupo (otro profesor → 403 RN-18; estudiante → 403).
# Por defecto estado=Activa; estado=Retirada para los retirados. search busca en nombre, apellidos y cédula. Sin
# teléfono ni dirección. Grupo inexistente → 404.
GET {{host}}/api/v1/grupos/1/estudiantes?estado=Activa&search=&page=1&pageSize=20
Authorization: Bearer {{token}}

###
